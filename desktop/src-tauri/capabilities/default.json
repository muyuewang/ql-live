{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "轻流直播默认权限：允许主窗口调用取源相关命令与 HTTP 请求",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://sjapi.91kds.cn/*" },
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    }
  ]
}