{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻流直播",
  "version": "1.3.2",
  "identifier": "com.muyue.qldesktop",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "轻流直播 - Windows 桌面版",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http: https:; media-src http: https: 'self' blob:; connect-src http: https: ipc: http://ipc.localhost ws: wss:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/tvbus/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}